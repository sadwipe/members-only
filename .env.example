NODE_ENV=development
PORT=3000
DB_URL="postgresql://<username>:<password>@localhost:5432/<db_name>"
SESSION_SECRET=<random_secret_string>

# used to view other users usernames (3 - 20 characters)
SECRET_PASSCODE=<any_passcode>

 # used to grant admin access
ADMIN_PASSWORD=<admin_password>

# Use the following command for generating session secrets:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"