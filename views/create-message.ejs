<!DOCTYPE html>
<html lang="en" class="h-full">
<%- include('head', { title: 'New Message' }) %>
<body class="min-h-full bg-[#FAF7F2] text-[#3C2A21] flex flex-col items-center justify-center py-12 px-4 sm:px-6 lg:px-8 selection:bg-[#C17C3B] selection:text-white">
  <div class="max-w-md w-full space-y-8 bg-[#FFFFFF] p-8 rounded-2xl shadow-md border border-[#E8E1D1]">
    <div class="text-center">
      <h2 class="text-3xl font-serif font-bold text-[#3C2A21]">Create a New Message</h2>
      <p class="mt-2 text-sm text-[#8C7A6B]">Share your thoughts with the community</p>
    </div>

    <form action="/create-message" method="POST" class="mt-8 space-y-4">
      <% if(locals.errors?.length) { %>
        <ul class="mt-4 p-3 bg-rose-50 border border-rose-200 rounded-xl space-y-1">
          <% errors.forEach(error => { %>
            <li class="text-sm text-rose-700 flex items-center"><%= error.msg %></li>
          <% }) %>
        </ul>
      <% } %>

      <div>
        <label for="title" class="block text-sm font-medium text-[#5C4538]">Title:</label>
        <input autofocus minlength="3" maxlength="25" type="text" id="title" name="title" required
          class="mt-1 block w-full px-3 py-2 bg-[#FAF7F2] border border-[#E8E1D1] rounded-lg shadow-sm placeholder-[#8C7A6B] text-[#3C2A21] focus:outline-none focus:ring-2 focus:ring-[#C17C3B] focus:border-[#C17C3B] sm:text-sm">
      </div>

      <div>
        <label for="message" class="block text-sm font-medium text-[#5C4538]">Message:</label>
        <textarea minlength="3" maxlength="300" name="message" id="message" rows="4" required
          class="resize-none mt-1 block w-full px-3 py-2 bg-[#FAF7F2] border border-[#E8E1D1] rounded-lg shadow-sm placeholder-[#8C7A6B] text-[#3C2A21] focus:outline-none focus:ring-2 focus:ring-[#C17C3B] focus:border-[#C17C3B] sm:text-sm"></textarea>
      </div>

      <button type="submit"
        class="w-full flex justify-center py-2.5 px-4 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-[#A65B32] hover:bg-[#8E4D29] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#C17C3B] transition-colors">
        Create
      </button>
    </form>

    <div class="text-center pt-2">
      <a href="/" class="text-sm font-medium text-[#A65B32] hover:text-[#8E4D29]">&larr; Back to Home</a>
    </div>
  </div>
</body>
</html>