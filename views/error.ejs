<!DOCTYPE html>
<html lang="en" class="h-full bg-gray-50">
<%- include('head', { title: `Error <%= status %>` }) %>
<body class="h-full flex flex-col items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-xl w-full space-y-6 bg-white p-8 rounded-xl shadow-lg border border-gray-100 text-center">
    <div>
      <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-semibold bg-red-100 text-red-800 mb-2">
        Error <%= status %>
      </span>
      <h1 class="text-2xl font-extrabold text-gray-900"><%= message %></h1>
    </div>

    <% if(error?.stack) { %>
      <div class="text-left mt-4">
        <h2 class="text-sm font-semibold text-gray-700 mb-1">Stack Trace:</h2>
        <pre class="bg-gray-900 text-gray-100 p-4 rounded-md text-xs overflow-x-auto max-h-64"><%= error.stack %></pre>
      </div>
    <% } %>

    <div class="pt-4">
      <a href="/" class="inline-flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors">
        Go Back Home
      </a>
    </div>
  </div>
</body>
</html>