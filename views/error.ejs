<!DOCTYPE html>
<html lang="en" class="h-full">
<%- include('head', { title: 'Error' }) %>
<body class="min-h-full bg-[#FAF7F2] text-[#3C2A21] flex flex-col items-center justify-center py-12 px-4 sm:px-6 lg:px-8 selection:bg-[#C17C3B] selection:text-white">
  <div class="max-w-xl w-full space-y-6 bg-[#FFFFFF] p-8 rounded-2xl shadow-md border border-[#E8E1D1] text-center">
    <div>
      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-rose-50 text-rose-700 border border-rose-200 mb-2">
        Error <%= status %>
      </span>
      <h1 class="text-2xl font-serif font-bold text-[#3C2A21]"><%= message %></h1>
    </div>

    <% if(error?.stack) { %>
      <div class="text-left mt-4">
        <h2 class="text-xs font-semibold uppercase tracking-wider text-[#8C7A6B] mb-1">Stack Trace:</h2>
        <pre class="bg-[#261E1B] text-[#E6DFD5] p-4 rounded-xl text-xs overflow-x-auto max-h-64 border border-[#3D312C]"><%= error.stack %></pre>
      </div>
    <% } %>

    <div class="pt-4">
      <a href="/" class="inline-flex justify-center py-2.5 px-5 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-[#A65B32] hover:bg-[#8E4D29] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#C17C3B] transition-colors">
        Go Back Home
      </a>
    </div>
  </div>
</body>
</html>