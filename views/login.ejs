<!DOCTYPE html>
<html lang="en" class="h-full">
<%- include('head', { title: 'Login' }) %>
<body class="min-h-full bg-[#FAF7F2] text-[#3C2A21] flex flex-col items-center justify-center py-12 px-4 sm:px-6 lg:px-8 selection:bg-[#C17C3B] selection:text-white">
  <div class="max-w-md w-full space-y-8 bg-[#FFFFFF] p-8 rounded-2xl shadow-md border border-[#E8E1D1]">
    <div class="text-center">
      <h2 class="text-3xl font-serif font-bold text-[#3C2A21]">Log In</h2>
      <p class="mt-2 text-sm text-[#8C7A6B]">
        Don't have an account? <a href="/register" class="font-medium text-[#A65B32] hover:text-[#8E4D29]">Register here</a>
      </p>
    </div>

    <% if(locals.success?.length) { %>
      <ul class="space-y-1">
        <% success.forEach(message => { %>
          <li class="text-sm text-[#8A5230] bg-[#FAF3EC] border border-[#EED7C8] p-3 rounded-xl"><%= message %></li>
        <% }) %>
      </ul>
    <% } %>

    <% if(locals.errors?.length) { %>
      <ul class="space-y-1">
        <% errors.forEach(message => { %>
          <li class="text-sm text-rose-700 bg-rose-50 border border-rose-200 p-3 rounded-xl"><%= message %></li>
        <% }) %>
      </ul>
    <% } %>

    <form action="/login" method="POST" class="mt-8 space-y-4">
      <div>
        <label for="username" class="block text-sm font-medium text-[#5C4538]">Username:</label>
        <input autocomplete="" autofocus type="text" name="username" id="username" required minlength="3" maxlength="30"
          class="mt-1 block w-full px-3 py-2 bg-[#FAF7F2] border border-[#E8E1D1] rounded-lg shadow-sm placeholder-[#8C7A6B] text-[#3C2A21] focus:outline-none focus:ring-2 focus:ring-[#C17C3B] focus:border-[#C17C3B] sm:text-sm">
      </div>

      <div>
        <label for="password" class="block text-sm font-medium text-[#5C4538]">Password:</label>
        <input type="password" name="password" id="password" required minlength="3" maxlength="20"
          class="mt-1 block w-full px-3 py-2 bg-[#FAF7F2] border border-[#E8E1D1] rounded-lg shadow-sm placeholder-[#8C7A6B] text-[#3C2A21] focus:outline-none focus:ring-2 focus:ring-[#C17C3B] focus:border-[#C17C3B] sm:text-sm">
      </div>

      <button type="submit"
        class="w-full flex justify-center py-2.5 px-4 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-[#A65B32] hover:bg-[#8E4D29] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#C17C3B] transition-colors">
        Log In
      </button>
    </form>
    
    <div class="text-center pt-2">
      <p class="text-sm text-[#8C7A6B]">
        <a href="/" class="font-medium text-[#A65B32] hover:text-[#8E4D29]">&larr; Back to main page</a>
      </p>
    </div>
  </div>
</body>
</html>