<!DOCTYPE html>
<html lang="en" class="h-full">
<%- include('head', { title: 'Homepage' }) %>
<body class="min-h-full bg-[#FAF7F2] text-[#3C2A21] flex flex-col selection:bg-[#C17C3B] selection:text-white">
  
  <header class="bg-[#F4EFEA] border-b border-[#E8E1D1] py-4 px-6 shadow-sm">
    <div class="max-w-7xl mx-auto flex justify-between items-center">
      <div class="flex items-center space-x-3">
        <span class="text-2xl">☕</span>
        <h1 class="text-lg font-serif tracking-wide text-[#3C2A21] font-semibold">The Artisan Clubhouse</h1>
      </div>
      <span class="text-xs text-[#8C7A6B] italic">Single-Origin Discussions & Warm Brews</span>
    </div>
  </header>

  <div class="max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 flex-grow grid grid-cols-1 lg:grid-cols-4 gap-8">
    
    <aside class="lg:col-span-1 space-y-6">
      <div class="bg-[#FFFFFF] p-6 rounded-2xl shadow-md border border-[#E8E1D1] space-y-6 sticky top-8">
        <div>
          <h2 class="text-xs uppercase tracking-widest text-[#8C7A6B] font-semibold">Barista Station</h2>
          <% if(locals.currentUser) { %>
            <p class="text-base font-serif text-[#3C2A21] mt-1">Welcome back, <span class="font-medium text-[#A65B32]"><%= currentUser.username %></span></p>
          <% } else { %>
            <p class="text-base font-serif text-[#3C2A21] mt-1">Hello, <span class="font-medium text-[#A65B32]">Stranger</span></p>
          <% } %>
        </div>

        <% if(locals.success?.length) { %>
          <ul class="space-y-1">
            <% success.forEach(message => { %>
              <li class="text-xs text-[#8A5230] bg-[#FAF3EC] border border-[#EED7C8] p-2.5 rounded-lg"><%= message %></li>
            <% }) %>
          </ul>
        <% } %>

        <% if(locals.errors?.length) { %>
          <ul class="space-y-1">
            <% errors.forEach(error => { %>
              <li class="text-xs text-rose-700 bg-rose-50 border border-rose-200 p-2.5 rounded-lg"><%= error %></li>
            <% }) %>
          </ul>
        <% } %>

        <div class="space-y-3 pt-3 border-t border-[#E8E1D1]">
          <% if(locals.currentUser) { %>
            <a href="/create-message" class="w-full inline-flex justify-center py-2.5 px-4 rounded-lg shadow-sm text-sm font-medium text-white bg-[#A65B32] hover:bg-[#8E4D29] transition-colors">
              Pour a New Post
            </a>
            <a href="/membership" class="w-full inline-flex justify-center py-2.5 px-4 rounded-lg shadow-sm text-sm font-medium text-[#5C4538] bg-[#F4EFEA] hover:bg-[#EAE2D8] border border-[#D9CEBE] transition-colors">
              Join the Club
            </a>
            <a href="/admin-riddle" id="runaway-btn" class="relative transition-all duration-100 w-full inline-flex justify-center py-2.5 px-4 border border-dashed border-[#C17C3B] rounded-lg shadow-sm text-sm font-medium text-[#A65B32] bg-[#FAF3EC] hover:bg-[#F4EFEA]">
              Gain Admin Access 
            </a>
            <form action="/logout" method="POST">
              <button type="submit" class="w-full inline-flex justify-center py-2.5 px-4 rounded-lg shadow-sm text-sm font-medium text-rose-700 bg-[#FFFFFF] hover:bg-rose-50 border border-[#E8E1D1] transition-colors">
                Log Out
              </button>
            </form>
          <% } else { %>
            <a href="/register" class="w-full inline-flex justify-center py-2.5 px-4 rounded-lg shadow-sm text-sm font-medium text-white bg-[#A65B32] hover:bg-[#8E4D29] transition-colors">
              Register
            </a>
            <a href="/login" class="w-full inline-flex justify-center py-2.5 px-4 rounded-lg shadow-sm text-sm font-medium text-[#5C4538] bg-[#F4EFEA] hover:bg-[#EAE2D8] border border-[#D9CEBE] transition-colors">
              Log In
            </a>
            <p class="text-xs text-center text-[#8C7A6B] pt-2">Register to share your thoughts over a cup!</p>
          <% } %>
        </div>
      </div>
    </aside>

    <main class="lg:col-span-3 space-y-6">
      <div class="bg-[#FFFFFF] p-6 rounded-2xl shadow-md border border-[#E8E1D1] flex justify-between items-center">
        <div>
          <h2 class="text-2xl font-serif text-[#3C2A21]">Community Feed</h2>
          <p class="text-sm text-[#8C7A6B]">Fresh notes and conversations shared by our members.</p>
        </div>
      </div>

      <% if(locals.messages?.length) { %>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <% messages.forEach(message => { %>
            <div class="bg-[#FFFFFF] p-6 rounded-2xl shadow-md border border-[#E8E1D1] flex flex-col justify-between space-y-4 hover:border-[#D9CEBE] transition-all">
              <div class="space-y-2">
                <div class="flex justify-between items-center gap-2">
                  <h3 class="text-lg font-serif text-[#A65B32] font-semibold"><%= message.title %></h3>
                  <% if(locals.currentUser?.is_admin) { %>
                    <form action="/messages/<%= message.id %>/delete" method="POST" class="inline">
                      <button type="submit" class="text-[#8C7A6B] hover:text-rose-600 font-bold px-2 py-0.5 rounded transition-colors text-sm" title="Delete message">
                        &#10006;
                      </button>
                    </form>
                  <% } %>
                </div>
                <p class="text-[#5C4538] text-sm whitespace-pre-line leading-relaxed"><%= message.text %></p>
              </div>
              <div class="pt-4 border-t border-[#F4EFEA] flex justify-between items-center text-xs text-[#8C7A6B]">
                <% if(locals.currentUser) { %>
                  <span class="font-medium text-[#3C2A21]">Author: <%= currentUser.membership_status || currentUser.is_admin ? `${message.first_name} ${message.last_name}` : 'Unknown (Members Only)' %></span>
                  <span><%= currentUser.membership_status || currentUser.is_admin ? new Date(message.timestamp).toLocaleDateString() : '' %></span>
                 <% } else { %>
                  <span class="font-medium text-[#8C7A6B]">Author: Unknown (Members Only)</span>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="bg-[#FFFFFF] p-12 rounded-2xl shadow-md border border-[#E8E1D1] text-center text-[#8C7A6B]">
          No messages found. Be the first to brew one!
        </div>
      <% } %>
    </main>

  </div>
</body>
</html>