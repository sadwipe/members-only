<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Homepage</title>
  <style>
    ul {
      padding: 0;
      list-style: none;
    }
    .success {
      padding: 2px 4px;
      background-color: lightgreen;
      width: fit-content;
    }
  </style>
</head>
<body>
  <h2>This is a protected route</h2>
  <% if(locals.success?.length) { %>
    <ul>
      <% success.forEach(message => { %>
        <li class="success"><%= message %></li>
      <% }) %>
    </ul>
  <% } %>
</body>
</html>